+			dirty = gba->memory.savedata.dirty;
+			lingoRegionsAdd(&rs, "ewram", gba->memory.wram, GBA_SIZE_EWRAM);
+			lingoRegionsAdd(&rs, "iwram", gba->memory.iwram, GBA_SIZE_IWRAM);
+			lingoRegionsAdd(&rs, "vram", gba->video.vram, GBA_SIZE_VRAM);
